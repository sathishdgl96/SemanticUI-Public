SEMANTICUI_AUTH_MODE=dev
SEMANTICUI_ENVIRONMENT=development
SEMANTICUI_SECRET_KEY=change-me-32-bytes-of-entropy
SEMANTICUI_DATABASE_URL=postgresql+psycopg://semanticui:semanticui@localhost:5432/semanticui
# --- Sign-in (oauth mode) -------------------------------------------
# SEMANTICUI_AUTH_MODE=oauth
# The account queries run against, whichever IdP issued the token:
# SEMANTICUI_SNOWFLAKE_ACCOUNT=myorg-myaccount
# SEMANTICUI_OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback
#
# Option A -- SNOWFLAKE OAuth (the default): the id/secret come from a
# Snowflake security integration, and Snowflake hosts the login page.
# SEMANTICUI_OAUTH_CLIENT_ID=...
# SEMANTICUI_OAUTH_CLIENT_SECRET=...
#
# Option B -- your CORPORATE IdP (Azure Entra ID, Okta): the id/secret
# come from the IdP app registration, the IdP hosts the login, and
# Snowflake validates its tokens via an EXTERNAL_OAUTH security
# integration. Setting the two endpoints is what selects this mode.
# Full walkthrough: docs/operations/snowflake-sso.md
# SEMANTICUI_OAUTH_CLIENT_ID=<Application (client) ID>
# SEMANTICUI_OAUTH_CLIENT_SECRET=<client secret VALUE, not its id>
# SEMANTICUI_OAUTH_AUTHORIZE_URL=https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/authorize
# SEMANTICUI_OAUTH_TOKEN_URL=https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/token
# SEMANTICUI_OAUTH_SCOPE=api://<app-id-uri>/session:role:analyst offline_access

# Branding: the product name shown everywhere (shell, login, browser title,
# the XMLA catalog Excel sees, Basic-auth realms) and an optional logo URL.
# SEMANTICUI_APP_NAME=SemanticUI
# SEMANTICUI_APP_LOGO_URL=https://example.com/logo.svg
# ...or a file on this machine, served by the app at /api/branding/logo:
# SEMANTICUI_APP_LOGO_FILE=C:/branding/logo.png

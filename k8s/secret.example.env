# Template for the semanticui-env Secret. Copy to k8s/.env (which git
# ignores), fill in real values, then:
#
#   kubectl create secret generic semanticui-env --from-env-file=k8s/.env
#
# The real file must never reach git or the image; this template carries
# placeholders only. The production validators in backend/app/config.py
# refuse to boot on the default secret key, dev auth, or a localhost
# database, so a half-filled copy fails loudly at startup.

SEMANTICUI_ENVIRONMENT=production
SEMANTICUI_AUTH_MODE=oauth

# 32+ characters of real entropy, e.g.:  openssl rand -hex 32
SEMANTICUI_SECRET_KEY=change-me-32-bytes-of-entropy

# Managed Postgres or an in-cluster operator; localhost is rejected.
SEMANTICUI_DATABASE_URL=postgresql+psycopg://semanticui:PASSWORD@db-host:5432/semanticui

# The account queries run against, whichever IdP issued the token.
SEMANTICUI_SNOWFLAKE_ACCOUNT=myorg-myaccount

# Must match the Ingress host AND the IdP app registration.
SEMANTICUI_OAUTH_REDIRECT_URI=https://semanticui.example.com/auth/callback

# Option A -- SNOWFLAKE OAuth (the default): id/secret from a Snowflake
# security integration; Snowflake hosts the login page.
SEMANTICUI_OAUTH_CLIENT_ID=...
SEMANTICUI_OAUTH_CLIENT_SECRET=...

# Option B -- corporate IdP (Entra ID, Okta): setting the two endpoints
# selects this mode; id/secret then come from the IdP app registration.
# Full walkthrough: docs/operations/snowflake-sso.md
# SEMANTICUI_OAUTH_AUTHORIZE_URL=https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/authorize
# SEMANTICUI_OAUTH_TOKEN_URL=https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/token
# SEMANTICUI_OAUTH_SCOPE=api://<app-id-uri>/session:role:analyst offline_access

# Who may open the admin area. Unset means nobody.
# SEMANTICUI_APP_ADMINS=["A_SMITH","J_PATEL"]
